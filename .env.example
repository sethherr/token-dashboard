# Token Dashboard — environment variables
#
# Copy to .env and uncomment what you need:
#
#     cp .env.example .env
#
# .env is read by ./start.sh and is gitignored. Every value here is optional —
# the defaults below are what you get if the file is absent.
#
# Precedence, highest first:
#   1. command-line flags   ./start.sh --db /path/to/cache.db
#   2. the environment      PORT=9000 ./start.sh
#   3. this file
#   4. built-in defaults
#
# Format notes: KEY=value, one per line. Quote values containing spaces.
# Inline comments are NOT stripped — `PORT=8080 # web` sets PORT to "8080 # web".
# Put comments on their own line.


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the local web server listens on.
# Default: 8080
#PORT=8080

# Bind address. KEEP THE DEFAULT unless you know what you're doing.
# Setting 0.0.0.0 exposes your entire prompt history — every prompt you've
# typed, file path you've touched, and project name — to anyone on the same
# network. Don't do this on coffee-shop Wi-Fi, in a coworking space, or on any
# network you don't fully control.
# Default: 127.0.0.1
#HOST=127.0.0.1

# Skip opening a browser tab on startup. Same as passing --no-open.
# True values: 1, true, yes, on (case-insensitive).
# Default: false
#NO_AUTO_OPEN_BROWSER=true


# ---------------------------------------------------------------------------
# Data locations
# ---------------------------------------------------------------------------

# Where to scan for Claude Code session JSONL files.
# Default: ~/.claude/projects
# (If unset, the dashboard also honours a .claude folder chosen in Settings,
# falling back to ~/.claude/projects.)
#CLAUDE_PROJECTS_DIR=/Users/you/.claude/projects

# SQLite cache location. This file is generated — delete it to rebuild from
# scratch with `python3 cli.py scan`.
# Default: ~/.claude/token-dashboard.db
#TOKEN_DASHBOARD_DB=/Users/you/.claude/token-dashboard.db


# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# Path to the rtk binary, for the optional RTK savings tab.
# Only needed if rtk isn't on your PATH or in a common install dir
# (~/.local/bin, ~/.cargo/bin, /opt/homebrew/bin, /usr/local/bin).
# Default: auto-detected
#TOKEN_DASHBOARD_RTK_BIN=/opt/homebrew/bin/rtk
